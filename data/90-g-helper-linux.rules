# G-Helper Linux: ROG-/M4-Taste und Fn-Tasten des ASUS-WMI-Hotkey-Geräts für den
# angemeldeten Nutzer lesbar machen (evdev-Hotkey-Listener der GUI).
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="Asus WMI hotkeys", TAG+="uaccess"

# G-Helper Linux: GNOME (Mutter) soll die NVIDIA-Karte nicht öffnen, damit Eco sofort
# umschalten kann (wie G-Helper unter Windows). Nur im Hybrid-Betrieb (gpu_mux_mode=1):
# Bei MUX = Ultimativ hängt der interne Bildschirm an der NVIDIA-Karte → dann kein Tag.
# Programme/Spiele können die Karte weiterhin selbst nutzen (PRIME-Offload).
SUBSYSTEM=="drm", KERNEL=="card[0-9]*", ATTRS{vendor}=="0x10de", PROGRAM=="/usr/bin/cat /sys/class/firmware-attributes/asus-armoury/attributes/gpu_mux_mode/current_value", RESULT=="1", TAG+="mutter-device-ignore"
