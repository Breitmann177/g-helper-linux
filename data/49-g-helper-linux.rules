// G-Helper Linux: lokale, aktive Admin-Nutzer (Gruppe wheel) dürfen den
// Hardware-Helfer ohne Passwort-Abfrage ausführen.
polkit.addRule(function (action, subject) {
    if (action.id == "io.github.ghelper-linux.helper" &&
        subject.local && subject.active && subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
